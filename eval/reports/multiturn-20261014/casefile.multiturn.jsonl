{"id": "mt-01", "title": "客户维度的连续追问", "scoring": "初赛 优化-多轮对话上下文保持（连续 5 轮以上准确 → 5 分）", "notes": "每轮均检查最终答案；所有省略客户主体的轮次都必须接上上下文。第 2 轮“只看美国的”依赖上一轮的客户对象，不能按独立问题判分。", "turns": [{"round": 1, "question": "平台上一共有多少位客户？", "expect_contains": ["59"], "depends_on_context": false, "expect_row_count": 1, "expect_columns": ["customer_count"]}, {"round": 2, "question": "只看美国的", "expect_contains": ["13"], "depends_on_context": true, "expect_row_count": 1, "expect_columns": ["customer_count"], "expect_sql_contains": ["customer", "country", "USA"]}, {"round": 3, "question": "改成按城市分组", "expect_contains": ["共 12 行"], "depends_on_context": true, "expect_row_count": 12, "expect_columns": ["city", "customer_count"], "expect_sql_contains": ["city", "USA"], "expect_sql_absent": ["support_rep_id"]}, {"round": 4, "question": "那按员工分组呢", "expect_contains": ["共 3 行"], "depends_on_context": true, "expect_row_count": 3, "expect_columns": ["employee_name", "customer_count"], "expect_sql_contains": ["USA"], "expect_sql_absent": ["city"]}, {"round": 5, "question": "这个再按国家分一下", "expect_contains": ["共 3 行", "USA"], "depends_on_context": true, "expect_row_count": 3, "expect_columns": ["employee_name", "country", "customer_count"], "expect_sql_contains": ["employee_name", "country", "USA"]}]}
{"id": "mt-02", "title": "发票聚合的连续切换", "scoring": "初赛 优化-多轮对话上下文保持（连续 5 轮以上准确 → 5 分）", "notes": "“改成按月拆开”表示月份替换国家维度；按结果值、行数与聚合/日期 SQL 事实判定，不要求模型采用固定列别名。", "turns": [{"round": 1, "question": "所有发票的总金额是多少？", "expect_contains": ["2328.6"], "depends_on_context": false, "expect_row_count": 1, "expect_sql_contains": ["sum(total)"]}, {"round": 2, "question": "那按开票国家分一下", "expect_contains": ["共 24 行"], "depends_on_context": true, "expect_row_count": 24, "expect_sql_contains": ["billing_country", "sum(total)"]}, {"round": 3, "question": "改成按月拆开", "expect_contains": ["共 60 行", "2021-01"], "depends_on_context": true, "expect_row_count": 60, "expect_sql_contains": ["invoice_date", "sum(total)"], "expect_sql_absent": ["billing_country"]}, {"round": 4, "question": "那平均每张是多少", "expect_contains": ["共 60 行", "5.94"], "depends_on_context": true, "expect_row_count": 60, "expect_sql_contains": ["invoice_date", "avg("], "expect_sql_absent": ["billing_country"]}, {"round": 5, "question": "这个最多的是哪个", "expect_contains": ["2024-09", "7.785"], "depends_on_context": true, "expect_row_count": 1, "expect_sql_contains": ["invoice_date", "avg("], "expect_sql_absent": ["billing_country"]}]}
{"id": "mt-03", "title": "单个实体的逐层下钻", "scoring": "初赛 优化-多轮对话上下文保持（连续 5 轮以上准确 → 5 分）", "notes": "客户消费、发票数和曲目必须都限定在 Frank Harris；聚合结果与显式排序指标须出现在本轮答案中。", "turns": [{"round": 1, "question": "客户 Frank Harris 是谁？", "expect_contains": ["Frank"], "depends_on_context": false, "expect_row_count": 1}, {"round": 2, "question": "他总共消费了多少？", "expect_contains": ["37.62"], "expect_absent": ["2328.6"], "depends_on_context": true, "expect_row_count": 1}, {"round": 3, "question": "改成看发票张数", "expect_contains": ["invoice_count：7"], "expect_absent": ["412"], "depends_on_context": true, "expect_row_count": 1, "expect_columns": ["invoice_count"]}, {"round": 4, "question": "那他都买过哪些曲目", "expect_contains": ["共 38 行"], "expect_absent": ["1888"], "depends_on_context": true, "expect_row_count": 38, "expect_sql_contains": ["track", "customer"]}, {"round": 5, "question": "只看播放时长最长的", "expect_contains": ["Heaven Can Wait", "440555"], "depends_on_context": true, "expect_row_count": 1, "expect_sql_contains": ["milliseconds"]}]}
{"id": "mt-04", "title": "文档问答的连续追问", "scoring": "初赛 优化-多轮对话上下文保持（连续 5 轮以上准确 → 5 分）", "notes": "文档问答连续追问。每轮必须命中该轮对应的合同事实，单有接续标记或引用不算答案正确。", "turns": [{"round": 1, "question": "智能计算设备年度维保服务合同里，质保期是多久？", "expect_contains": ["36"], "depends_on_context": false}, {"round": 2, "question": "那 GPU 加速卡呢", "expect_contains": ["24"], "depends_on_context": true}, {"round": 3, "question": "这个在合同第几条", "expect_contains": ["2.1"], "depends_on_context": true}, {"round": 4, "question": "它的适用范围呢", "expect_contains": ["GPU", "外接显示器"], "depends_on_context": true}, {"round": 5, "question": "那服务响应时限是多少", "expect_contains": ["30", "分钟", "2", "小时"], "depends_on_context": true}]}
