# ============================================================
# .env.example —— 环境变量模板（占位符，不含任何真实凭据）
# 用法：cp .env.example .env  然后填入真实值；.env 已被 .gitignore 忽略
# 依据：项目行为基准「明确禁止」条 —— 禁止把密钥、Token、账号密码写进代码或提交进仓库
# ============================================================

# ---- 业务数据库（PostgreSQL，见 infra/docker-compose.yml）----
# 宿主机侧连接一律用 127.0.0.1，不要写 localhost ——
# compose 的端口映射是 "127.0.0.1:5432:5432"（只绑 IPv4 回环），
# 而 Windows 上 localhost 会优先解析到 ::1，可能直接连不上。
# 容器之间互访则用服务名 db（见 infra/docker-compose.yml 的 healthcheck）。
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
# 容器默认库。业务库叫 chinook，它是 infra/initdb/02_chinook.sql 建的，与 POSTGRES_DB 无关；
# 把 POSTGRES_DB 设成 chinook 会让该脚本的 DROP DATABASE 删掉自己所在的库。
POSTGRES_DB=postgres
# 与 infra/docker-compose.yml 的 ${POSTGRES_USER:-ict} 保持一致
POSTGRES_USER=ict
# 注意：compose 里这条是必填（${POSTGRES_PASSWORD:?…}），本模板不含真实凭据，
# 复制成 .env 后请改成自己的口令，并同步改下面两个 URL 里的口令。
POSTGRES_PASSWORD=ict_dev_only_change_me

# 变量名必须是 DATABASE_URL / ADVENTUREWORKS_URL ——
# infra/scripts/export_schema_meta.py 与 verify_infra.py 读的就是这两个名字。
# 前缀必须是 postgresql://：脚本用 psycopg3 直连，不能带 SQLAlchemy 的方言后缀 +psycopg。
# （A 侧用 SQLAlchemy 2.0 时若需要 +psycopg 后缀，在自己的连接层处理，不要改这一行。）
# Chinook（11 表）：全链路跑通主力库。库名是 chinook，不是 postgres。
DATABASE_URL=postgresql://ict:ict_dev_only_change_me@127.0.0.1:5432/chinook

# AdventureWorks（71 张基表 + 9 个视图 = 80 个对象）：仅服务中级任务 4「Schema Linking」的举证。
# 库名必须是 postgres：数据烘焙在这个库里，写成 adventureworks 只会连到一个空壳库
# （空壳库下 pg_isready 照样通过，健康检查因此改为断言对象数 80）。
ADVENTUREWORKS_URL=postgresql://postgres:postgres@127.0.0.1:5433/postgres
# 压力库容器（infra/docker-compose.aw.yml）的 POSTGRES_PASSWORD，该 compose 的默认值是 postgres
AW_POSTGRES_PASSWORD=postgres

# ---- 向量库（pgvector，与 Chinook 同容器）----
# 决定 RAG 链路把文档切片的向量写到哪里，是「文档问答要不要每次重算」的唯一开关。
#   设了   -> PgVectorStore：写进 chinook 库的 chunk_vectors / doc_meta 表，靠内容指纹
#             增量，没变的文档跳过 bge-m3 编码（实测：冷 173s -> 命中后 1.8s）。
#   不设   -> MemoryVectorStore：进程内、退出即丢，每次启动都重新编码全部语料。
# ⚠️ 它与下面「检索与向量库」一节的 VECTOR_STORE 不是一回事：代码读的是本变量，
#    VECTOR_STORE 目前没有任何代码读取。只改 VECTOR_STORE 不会有任何效果。
# 与 DATABASE_URL 同库同账号：向量表建在 chinook 里，不是另起一个库。
# 首次建索引：python -m app.rag.corpus   （之后重启会自动跳过未变文档）
PG_DSN=postgresql://ict:ict_dev_only_change_me@127.0.0.1:5432/chinook

# ⚠️ 上面 PG_DSN 管的是「语料索引工具」这一路（app/rag/corpus.py:440、
#    app/rag/retrieval/indexer.py:233、fusion.py:143、preflight.py:135）。
#    **在线文档问答走的是另一路**：app/rag/answer.py:572-573 读 RAG_DSN 后
#    传给 index_corpus(dsn=...)。不设 RAG_DSN，问答进程就回落内存向量库，
#    每次重启都重算、首次提问要等 bge-m3 编码（实测冷启动 173 秒）。
#    app/database_api.py:138-139 的告警就是为了提示这个分裂。
#    值与 PG_DSN 相同即可：pgvector 与 Chinook 同容器，本就不是两个库。
RAG_DSN=postgresql://ict:ict_dev_only_change_me@127.0.0.1:5432/chinook

# ---- 国产大模型 API（生成）----
# 供 A 的编排层与 B 的 RAG 链路使用；C 的评测脚本（eval/、infra/）不读这几个变量，
# 因此只跑数据库与评测时，这一节可以整段留空。
# 模型名与 API 地址以实际申请到的为准，模板里不写死。
# 【模型名写法约定（2026-10-03）】配置值写厂商给的模型 ID（本项目用国产 DeepSeek 系列，
# 统一写成 deepseek-v4.1-flash）；文档与报告正文里指代模型，统一写人读形式 DeepSeek-V4.1-Flash。
# ⚠️ 若模型带思维链（如 DeepSeek-V4.1-Flash），其推理词元**计入** max_tokens，
#    单次输出上限必须给足（本项目 NL2SQL_MAX_TOKENS=16000），否则会「想一半就断、正文为空」。
LLM_API_BASE=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2

# 可选模型切换配置：不填 GLM4_API_KEY 时，界面会显示 GLM-4-Flash「未配置」且不可选。
# 所有密钥只保存在服务端环境变量 / 本机 .env，绝不放入前端配置。
# GLM4_API_KEY=
# GLM4_API_BASE=https://open.bigmodel.cn/api/paas/v4/
# GLM4_MODEL=glm-4-flash
# 若需分别配置 DeepSeek 凭据，可使用以下可选覆盖项；不填时沿用上方 LLM_*。
# DEEPSEEK_API_KEY=
# DEEPSEEK_API_BASE=
# DEEPSEEK_MODEL=deepseek-v4.1-flash

# ---- 本地小模型（bge 系列，做向量与重排）----
# 写 HF 仓库名时，首次运行会去下载权重（bge-m3 约 2GB、重排约 2.2GB，只在第一次）。
# 权重已下到本机后，建议改成指向目录，免得每次加载都去问网络：
#   BGE_EMBEDDING_MODEL=D:/askdata-agent/models/bge-m3
#   BGE_RERANKER_MODEL=D:/askdata-agent/models/bge-reranker-v2-m3
# ⚠️ 不要留成 `KEY=` 这种空赋值：空值既不是"用默认"也不是"用本地"，
#    而是一个会传给模型加载器的空字符串（会报 Repo id must be in the form ...）。
BGE_EMBEDDING_MODEL=BAAI/bge-m3
BGE_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
MODEL_CACHE_DIR=./models

# ---- HuggingFace 网络（下载模型时才会用到）----
# HF_HUB_OFFLINE：首次拉模型时保持 0（允许联网）；
#   权重已完整缓存、要完全离线运行时才改成 1 —— 设 1 而权重不在本机会直接加载失败。
HF_HUB_OFFLINE=0
# 直连 huggingface.co 不通的环境（DNS 被污染）按机器情况启用镜像：
# HF_ENDPOINT=https://hf-mirror.com

# ---- 检索与向量库 ----
# 文档检索：rag 为真实语料检索；mock 仅用于离线编排测试。
# rag_multihop = 在检索外面加「查询分解 + 多轮检索」，用于多文档/多跳问题。
DOC_SEARCH_BACKEND=rag
# 注：VECTOR_STORE 目前没有任何代码读取（历史遗留声明）。
# 向量落哪里由上面的 PG_DSN 决定，那一行才是开关。
VECTOR_STORE=pgvector
RETRIEVE_TOP_K=20
RERANK_TOP_K=5

# ---- 用户手动选择的 KAG 深度文档检索（可选；默认关闭）----
# 本机隔离索引 ID40 已通过构建质量门和候选映射烟测；此模板仍默认关闭。
# 普通 RAG 不依赖这些设置；启用后只对用户手动选择的文档深度检索生效。
# KAG_RUNTIME_DIR=D:/kag/workspace/askdata_mainline_deep_reasonnone_20261015
# KAG_PYTHON=D:/kag/python310/python.exe
# 单题补充检索 60 秒超时；候选条数 16 是完成跨文档烟测时使用的预算。
# KAG_QUERY_TIMEOUT_SECONDS=60
# KAG_MAX_CANDIDATES=16
# KAG_MAX_CONTEXT_CHARS=18000
# 模型凭据只从现有 DeepSeek 配置及进程环境读取，不要写入模板或提交到仓库。

# ---- 多跳检索（仅 DOC_SEARCH_BACKEND=rag_multihop 时生效）----
# RAG_MULTIHOP=0 是应急开关：即使后端选了多跳，也强制退回单轮。
# 默认 1 而不是 0 —— 默认 0 会造成「切了后端却不生效且不报错」的静默陷阱。
RAG_MULTIHOP=1
# 一次最多拆几个子查询
RAG_MAX_SUBQUERIES=3
# 最多检索几轮（含首轮）。2 表示允许一次补充检索
RAG_MAX_HOPS=2
# 各轮合并去重、再用原问题重排后，最多送几个片段进生成。
# 上限的意义：片段越多，模型的行内引用编号越容易错，且成本线性上升。
RAG_FINAL_CONTEXT_TOP_K=8

# ---- 扫描件 OCR（app/rag/ingest/ocr.py）----
# 只处理「整页没有文本层」的页（仅 .pdf，且该页字符数低于 OCR_MIN_TEXT_CHARS）。
# 依赖 rapidocr-onnxruntime（离线，模型权重随 wheel 内置，不需要联网下模型）。
# OCR_ENABLED=0 是应急开关：即使装好了也强制跳过 OCR，退回纯文本层抽取。
OCR_ENABLED=1
# 渲染 DPI。150 是实测默认值：100 DPI 约快 25%，但 KB-007 会少识别一行。
# 评测要点是编号与数字，宁可慢一点也不漏，所以默认 150。
OCR_RENDER_DPI=150
# 页级判据：一页文本层字符数低于这个值，就当作「这页没有文本层」。
OCR_MIN_TEXT_CHARS=20
# 页级 OCR 结果缓存目录（相对项目根；默认落在已 gitignore 的 agent_temp 下）。
# 单页实测 7 到 10 秒，不缓存的话每次启动重建索引都要重跑一遍。
OCR_CACHE_DIR=agent_temp/ocr_cache

# ---- 结构化链路（NL2SQL）----
# real = 真实链路（大模型生成 SQL → sqlglot 校验 → 连库执行，见 app/nl2sql/）；
# mock = 预置结果，只用于离线编排测试。
# 默认 real，与 DOC_SEARCH_BACKEND 的默认值同口径：真实能力为默认，mock 必须显式选。
NL2SQL_BACKEND=real
# 生成 SQL 的最大尝试次数（首次 + 校验失败后带着错误信息重写）。
NL2SQL_MAX_ATTEMPTS=3
# 单次生成的输出上限（token）。国产推理模型的思维链**计入**该上限，
# 给小了的表现是「想一半就断」、返回空内容。这是上限不是用量，给足不额外花钱。
NL2SQL_MAX_TOKENS=16000
# 答案里最多挂几条引用（引用卡片塞太多会把答案淹没）。
NL2SQL_MAX_REFS=3
# 字段定位预算（工程初值，未验证召回率 / 效率）；关系补全仍受真实元数据外键约束。
NL2SQL_LINK_MAX_TABLES=8
NL2SQL_LINK_MAX_COLUMNS=32
NL2SQL_LINK_MAX_RELATED_TABLES=12
# 新表字段定位、关联规划与SQL语义检查路径；评估验证后再决定是否默认开启。
NL2SQL_SEMANTIC_PLANNING_ENABLED=1

# ---- SQL 安全闸门 ----
SQL_DIALECT=postgres
SQL_READONLY_ONLY=true
SQL_AUTO_LIMIT=1000
SQL_LARGE_RESULT_MAX_ROWS=5000
RESULT_SET_CACHE_MAX_BYTES=16777216
RESULT_SET_CACHE_MAX_SETS=16
RESULT_SET_TTL_SECONDS=600
RESULT_SET_PAGE_SIZE=100
SQL_TIMEOUT_SECONDS=30

# ---- 多轮澄清状态（仅当前后端进程内存；多进程部署不共享）----
SESSION_MEMORY_MAX_SESSIONS=256
SESSION_MEMORY_TTL_SECONDS=1800
SESSION_MEMORY_MAX_CONTEXT_CHARS=4000

# ---- 运行环境 ----
APP_ENV=dev
LOG_LEVEL=INFO
# 时间基准（ISO 日期，如 2024-06-15）：「去年/本月」等相对时间词按它归一化。
# 跑分时必须固定（评测基准已定 2024-06-15）；留空 = 取系统当前时间。
# 写错格式会直接报错（不静默回落），见 app/nl2sql/config.time_anchor_from_env。
APP_TIME_ANCHOR=
# 临时文件目录（协作规范：统一放 ./agent_temp，收尾清理，不入库）
AGENT_TEMP_DIR=./agent_temp

# ---- 本地账号库 ----
# 留空时 app/auth_store.py:_database_path() 落到平台默认路径
# （Windows: %LOCALAPPDATA%\VeriMind\app\accounts.sqlite3），那是个空库，
# 会出现"账号注册过却登不进去"且无任何提示。指到工程内 agent_temp 可与项目同进退。
VERIMIND_AUTH_DB_PATH=./agent_temp/verimind-accounts.sqlite3
# 明文 HTTP 直连（127.0.0.1 / 局域网 IP）时置 false：Secure cookie 在
# 非 localhost 的 http:// 页面上被浏览器丢弃，表现为"登录成功但立刻掉线"。
VERIMIND_AUTH_COOKIE_SECURE=false
